function generarPDFArticulos(width, height, origen, indice) {
	var left = (screen.width / 2) - (width / 2);
	var top = (screen.height / 2) - (height / 2);
	var action = '';

	var params = [
		'width='+width,
		'height='+height,
		'resizable=yes',
		'scrollbars=yes',
		'menubar=no',
		'toolbar=no',
		'statusbar=no'
		// 'fullscreen=yes' // only works in IE
	].join(',');

	var popup = window.open('',	'windowCargando', params);
	popup.moveTo(left, top);

	if (origen == 'L') { // buscador de libros
		document.listaLibros.target = 'windowCargando';
		document.listaLibros.action = '/lib/buscar/cargandoPDF.php?origen_busqueda=L';
		document.listaLibros.submit();
		document.listaLibros.target = '';
		document.listaLibros.action = '/lib/buscar/listaLibros.php';
	} else if (origen == 'N') { // Novedades
		document.listaNovedades.target = 'windowCargando';
		document.listaNovedades.action = '/lib/buscar/cargandoPDF.php?origen_busqueda=N';
		document.listaNovedades.submit();
		document.listaNovedades.target = '';
		document.listaNovedades.action = '/lib/novedades/lista.php';
	} else if (origen == 'P') { // buscador de papelería
		document.buscadorPapeleria.target = 'windowCargando';
		document.buscadorPapeleria.action = '/lib/buscar/cargandoPDF.php?origen_busqueda=P';
		document.buscadorPapeleria.submit();
		document.buscadorPapeleria.target = '';
		document.buscadorPapeleria.action = '/lib/buscar/buscadorPapeleria.php';
	} else if (origen == 'X') { // expositores / lotes
		document.listaLotes.target = 'windowCargando';
		document.listaLotes.action = '/lib/buscar/cargandoPDF.php?tipoBusqueda=X';
		document.listaLotes.submit();
		document.listaLotes.target = '';
		document.listaLotes.action = '/lib/lotes/lista.php';
	} else if (origen == 'PRE') { // presupuestos
		var form = document.forms['formNotas'+indice];
		var action = form.action;
		form.target = 'windowCargando';
		form.action = '/html/lib/buscar/cargandoPDF.php';
		form.submit();
		form.target = '';
		form.action = action;
	} else if (origen == 'PREV'){
		document.listaPreventas.target = 'windowCargando';
		document.listaPreventas.action = '/lib/preventas/cargandoPDF.php?origen_busqueda=PREV&tipo='+indice;
		document.listaPreventas.submit();
		document.listaPreventas.target = '';
		document.listaPreventas.action = '/lib/preventas/lista.php';
	}
}

function verAdjuntoMedios(url) {
	muestraVentana(url, 800, 700);
}

function imprimir2() {
	var capasOcultar = new Array(
		'multipleActions', 'smenu', 'banner-top', 'banner_left',
		'banner_right', 'header', 'buscador', 'leftcol'
	);

	// Oculto las capas que no deben imprimirse
	for (i = 0; i < capasOcultar.length; i++)
		if (document.getElementById(capasOcultar[i]))
			document.getElementById(capasOcultar[i]).style.display = 'none';

	window.print();

	// Las vuelvo a mostrar
	for (i = 0; i < capasOcultar.length; i++)
		if (document.getElementById(capasOcultar[i]))
			document.getElementById(capasOcultar[i]).style.display = '';
}

function desactivarAtributosValoresVacios() {
	// Antes de hacer el 'submit', se desactivan todos los input con name="atributosValores[]" que tengan el value=""
	$('input[name="atributosValores[]"][value=""]').attr('disabled', 'disabled');
	$(':input', '#formBusqueda').each(function() {
		if($(this).val() == "") {
			$(this).attr('disabled','disabled');
		}

	});
}

function activarAtributosValoresVacios() {
	// Después de hacer el 'submit', se vuelven a activar todos los input con name="atributosValores[]" que tengan el value=""
	$('input[name="atributosValores[]"][value=""]').prop('disabled', false);
}

function setCookie(cname, cvalue, exdays) {
	var d = new Date();
	d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
	var expires = 'expires='+ d.toUTCString();
	document.cookie = cname + '=' + cvalue + '; ' + expires + '; path=/';
}

function guardarCookies(value) {
	// Se graba la cookie 'COOKIE_CONSENT' con los valores 'T' (Técninas), 'A' (Análisis) y 'P' (Personalización) y con 30 días de expiración
	if (typeof value === 'undefined' || value === null) {
		value = 'T';
		value += $('#aceptarCookie2').prop('checked') ? '-A' : '';
		value += $('#aceptarCookie3').prop('checked') ? '-P' : '';
	} else
		value = 'T-A-P';

	var name = 'COOKIE_CONSENT';
	var diasExpiracion = 30;
	setCookie(name, value, diasExpiracion);
}

function configuracionCookies() {
	$('.aceptarCookies').toggle();
	$('.configuracionCookies').toggle();
}

function infoCookies() {
	$('.aceptarCookies').toggle();
	$('.infoCookies').toggle();
}


//MAG 27/12/2023 hay que ponerlo en util.js porque el menu, al ser asincrono, no carga el fichero cookies.js
function guardarCookiesNuevas(rutaCookies, accion) {
	var cookies = [];

	$(".formCookie").each(function (index) {
		var id       = $(this).find('input[name="id"]').val();
		var aceptada = $(this).find('input[name="aceptada"]').prop('checked');

		cookies[index] = {
			'id':       id,
			'aceptada': aceptada
		};
	});

	$.ajax({
		type:    "POST",
		url:     rutaCookies + "guardarCookies.php",
		async:   false,
		data:    {
			cookies: cookies,
			accion:  accion
		},
		success: function (data) {
			// alert(data);
			window.location.reload();
		}
	});
}

function mostrarCookies()
{
	setCookie('COOKIE_CONSENT', '', -1);
	window.location.reload();
}


