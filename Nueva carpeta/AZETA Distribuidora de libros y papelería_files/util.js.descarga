function mostrarCapa(capa) {
	var elemento = document.getElementById(capa);
	if (typeof elemento != 'undefined' && elemento != null)
		elemento.style.display = '';
}

function ocultarCapa(capa) {
	var elemento = document.getElementById(capa);
	if (typeof elemento != 'undefined' && elemento != null)
		elemento.style.display = 'none';
}

function mostrarOcultarCapa(capa) {
	if (document.getElementById(capa).style.display == '')
		ocultarCapa(capa);
	else
		mostrarCapa(capa);

	return false;
}

function incrementaMiniCesta(posicion) {
	if ($('#producto'+posicion+' [name="actualizar[]"]').length)
		$('#producto'+posicion+' [name="actualizar[]"]').val('S');

	if (typeof document.cesta != 'undefined') { // Si esta la cesta abierta, incremento la cesta {
		incrementaCesta(posicion);
	} else {
		input = document.getElementById('miniCesta'+posicion);

		if (input.value == '')
			input.value = '1'
		else
			input.value = parseInt(input.value) + 1;
		meterCesta();
	}
}

function decrementaMiniCesta(posicion) {
	if ($('#producto'+posicion+' [name="actualizar[]"]').length)
		$('#producto'+posicion+' [name="actualizar[]"]').val('S');

	if (typeof document.cesta != 'undefined') // Si esta la cesta abierta,incremento la cesta
		decrementaCesta(posicion);
	else {
		input = document.getElementById('miniCesta'+posicion)

		if (input.value != '' && parseInt(input.value) > 1 )
			input.value = parseInt(input.value) - 1;
		else
			input.value = '1';

		meterCesta();
	}
}

function incrementaCesta(posicion) {
	var cantidad = document.getElementById('Cesta'+posicion);
	var articulo = document.getElementById('codArticulo'+posicion);


	if (cantidad.value == '')
		cantidad.value = '1';
	else
		cantidad.value = parseInt(cantidad.value) + 1;

	meterCesta();
}

function decrementaCesta(posicion) {
	var cantidad = document.getElementById('Cesta'+posicion);
	var articulo = document.getElementById('codArticulo'+posicion);

	if (cantidad.value != '' && parseInt(cantidad.value) > 1)
		cantidad.value = parseInt(cantidad.value) - 1;
	else
		cantidad.value = '';

	meterCesta();
}

function modificaCesta(posicion) {
	var cantidad = document.getElementById('Cesta'+posicion);
	var articulo = document.getElementById('codArticulo'+posicion);
	meterCesta(articulo.value, cantidad.value);
}

function cambiarCantidadMiniCesta(posicion) {
	if (typeof document.cesta != 'undefined') {
		inputMini = document.getElementById('miniCesta'+posicion);
		inputCesta = document.getElementById('Cesta'+posicion);
		inputCesta.value = inputMini.value;
	}

	if ($('#producto'+posicion+' [name="actualizar[]"]').length)
		$('#producto'+posicion+' [name="actualizar[]"]').val('S');

	meterCestaCompra();
}

function strpos(haystack, needle, offset) {
	var i = (haystack+'').indexOf(needle, (offset || 0));
	return i === -1 ? false : i;
}

function incrementaCantidad(idInput, posicion) {
	var input = document.getElementById(idInput + posicion);

	if (input.value == '')	input.value = '1';
	else					input.value = parseInt(input.value) + 1;

	if (idInput + posicion == idInput + 'Lote')
		marcarDesmarcarTodos(idInput);
}

function decrementaCantidad(idInput, posicion, permitirCero) {
	var input = document.getElementById(idInput + posicion);

	if (permitirCero == 'N')	minimo = 1;
	else						minimo = 0;

	if (input.value != '' && parseInt(input.value) > minimo)
		input.value = parseInt(input.value) - 1;
	else
		input.value = minimo;

	if (idInput + posicion == idInput + 'Lote')
		marcarDesmarcarTodos(idInput);
}

