function deshabilitarBotonCesta(boton) {
	botonCesta = boton; // Se guarda el boton y su atributo 'onclick' para poder recuperarlo cuando termine la acción
	onclickBotonCesta = $(botonCesta).attr('onclick');
	$(botonCesta).attr('onclick', 'return false'); // Se desactiva el evento 'onclick'
}

function habilitarBotonCesta() {
	if (botonCesta != null && onclickBotonCesta != null) {
		$(botonCesta).attr('onclick', onclickBotonCesta);
		botonCesta = null;
		onclickBotonCesta = null;
	}
}

