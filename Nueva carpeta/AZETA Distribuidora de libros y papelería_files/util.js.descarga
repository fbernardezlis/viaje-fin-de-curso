function mostrarOcultarPrecios(select) {
	var ocultarPrecios = select.options[select.selectedIndex].value;
	if (ocultarPrecios == 'S') // Ocultar precios
	{
		$('.precioCoste, .precioVenta').hide();
		$('.descuentoCliente').hide();
	}
	else if (ocultarPrecios == 'N') // Todos los precios
	{
		$('.precioCoste, .precioVenta').show();
		$('.descuentoCliente').show();
	}
	else if (ocultarPrecios == 'D') // Ocultar descuentos
	{
		$('.descuentoCliente').hide();
		$('.precioVenta').show();
	}

	else { // Solo precios de venta
		$('.precioCoste').hide();
		$('.precioVenta').show();
		$('.descuentoCliente').show();
	}

	$.ajax({
		dataType: 'json',
		data: 'ocultarPrecios='+ocultarPrecios,
		url: '/html/lib/buscar/ocultarPrecios.php',
		type: 'post'
	});
}

