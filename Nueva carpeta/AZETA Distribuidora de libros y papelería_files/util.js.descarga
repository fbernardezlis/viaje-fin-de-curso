function cambiarCabecera(cabecera) {
	$.ajax({
		url: '/age/clientes/cabeceras/seleccionar.php?cache='+Math.random(),
		type: 'POST',
		data: { id: cabecera },
		dataType: 'text',
		cache: false,
		beforeSend: function() {
			mostrarCargando('Activando la cabecera...');
		},
		complete: function() {
			modalCargando.close();
		},
		success: function(response) {
			if (parseInt(response) <= 0)
				mostrarMensaje('Aviso', response);
		//else
		//	irPagina('/age/clientes/cabeceras/lista.php', '<?=AJAX?>');
		},
	});
}

